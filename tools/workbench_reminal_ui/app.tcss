Screen { background: #08090b; color: #edf1f7; }
Header, Footer { background: #101216; }
#status { height: 1; padding: 0 1; background: #14231d; color: #78e2b0; }
#menu { height: 1fr; }
TabbedContent TabbedContent { height: auto; min-height: 12; }
#sequence-menu, #monitor-menu { height: 1fr; }
TabPane { padding: 0 1; }
VerticalScroll { padding: 0; }
Label { margin: 0; color: #a3adbc; }
.section-title { text-style: bold; color: #70d7ff; margin: 0; }
Input { height: 1; min-height: 1; border: none; padding: 0 1; background: #171a20; margin: 0; }
Input:focus { background: #172735; }
Select { height: 3; margin: 0; }
.form-row { height: auto; min-height: 1; margin-bottom: 1; align-vertical: middle; }
.form-row Label { width: 26; padding-right: 1; }
.form-row Input, .form-row Select { width: 1fr; }
.buttons { height: 1; min-height: 1; layout: horizontal; margin: 1 0; }
Button { height: 1; min-height: 1; min-width: 0; width: auto; border: none; padding: 0 1; background: #263440; color: #edf1f7; text-style: bold; }
Button:hover, Button:focus { background: #245269; color: #ffffff; }
.buttons Button { margin-right: 1; }
Checkbox { height: 1; min-height: 1; border: none; padding: 0; margin: 0; }
.buttons Checkbox { width: auto; margin-right: 2; }
.filters { height: 1; margin: 0; }
.filters Input { width: 1fr; margin-right: 1; }
TextArea { height: 16; min-height: 5; border: round #43526b; margin: 0; }
#editor_text, #lan_text { border: round #bcacff; }
#editor_diff, #transfer_diff, #split_diff, #lan_diff, #history_details, #telemetry_details { height: 8; border: round #78e2b0; }
#telemetry_schema { height: 18; border: round #ffd078; }
#fighter_summary { height: 8; border: round #f3a2d6; }
#ready { height: 1; margin: 0 1; color: #ffd078; }
.log-pane { height: 22; border: round #43526b; padding: 0 1; margin: 0; }
.log-pane Label { margin: 0; }
.log-pane .buttons { margin: 0; }
.log-pane RichLog { height: 1fr; background: #08090b; padding: 0; }
#operation-log { height: 8; min-height: 8; margin: 0 1; border: round #70d7ff; }
#telemetry-log { border: round #bcacff; }
#diagnostic-log { border: round #ffd078; }
#live-log { border: round #78e2b0; }
#operation-log.hidden { display: none; }
.log-meta { height: 1; color: #a3adbc; }
LogViewer { align: center middle; background: #000000 65%; }
#log-viewer { width: 98%; height: 98%; padding: 0 1; background: #08090b; border: round #70d7ff; }
#expanded-log-text { height: 1fr; }
DataTable { height: 18; border: round #70d7ff; margin: 0; background: #08090b; }
#feature_table { border: round #f3a2d6; }
#history_table { border: round #bcacff; }
PlotextPlot { height: 10; border: round #70d7ff; margin: 0; }
#telemetry-chart { border: round #78e2b0; }
#activity-chart { border: round #bcacff; }
#welcome-text { height: 2; color: #f3a2d6; padding: 0; }
#outcome-cards { height: 4; }
.stat-card { width: 1fr; height: 4; border: round #70d7ff; padding: 0 1; }
.stat-card Static { text-style: bold; }
#card-success { border: round #78e2b0; }
#card-failed { border: round #ff8c9c; }
#card-other { border: round #ffd078; }
.metric-trends { height: 1; }
Sparkline { width: 1fr; height: 1; margin-right: 1; }
#packet-trend { color: #70d7ff; }
#byte-trend { color: #78e2b0; }
#telemetry_metrics { height: 1; color: #70d7ff; text-style: bold; }
.safety-note { color: #a3adbc; height: auto; }
Collapsible { padding: 0; margin: 0; border: none; }
Collapsible > Contents { padding: 0; }
Confirm { align: center middle; background: #000000 65%; }
#confirmation { width: 90%; max-width: 100; height: 85%; padding: 0 1; background: #101216; border: round #ffd078; }
#confirmation-details { height: 1fr; }
#confirmation .buttons { align-horizontal: right; }
